# ---------------------------------------------------------------------------
# PillPal API configuration. Copy this file to `.env` and adjust the values.
# Every variable has a sensible development default (see src/config.ts).
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#  - Docker (npm run db:up):      postgresql://pillpal:pillpal@localhost:5432/pillpal
#  - Local Postgres install:      postgresql://postgres:<your password>@localhost:5432/pillpal
#  - Neon / Supabase / Railway:   paste the connection string they give you
DATABASE_URL="postgresql://pillpal:pillpal@localhost:5432/pillpal"

# Port the API listens on
PORT=4000

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="1d"
REFRESH_TOKEN_DAYS=30

# Shared secret the Raspberry Pi sends when it registers itself (POST /api/v1/device/register)
DEVICE_PROVISIONING_KEY="pillpal-provisioning-dev"

# Key for maintenance endpoints (POST /api/v1/system/tick, GET /api/v1/system/stats)
ADMIN_API_KEY="pillpal-admin-dev"

# Allowed browser origins, comma separated, or * (mobile apps are not affected by CORS)
CORS_ORIGINS="*"

# Background job settings
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
DEVICE_OFFLINE_AFTER_MINUTES=5
DOSE_GENERATION_HORIZON_HOURS=48
COMMAND_TTL_MINUTES=15
CLAIM_CODE_TTL_MINUTES=30

# Push notifications (Expo). Leave PUSH_ENABLED=true; nothing is sent until a phone registers a token.
PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
